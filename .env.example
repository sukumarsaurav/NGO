APP_NAME="Vision Good Work Global Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

# QR code verification URLs derive from this — never hard-code the domain.
# See docs/06-UI-UX-FOUNDATION.md §10 (canonical host) and M04.
DOCUMENT_QR_BASE_URL="${APP_URL}/verify"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error monitoring (config/sentry.php). Left blank in dev/staging is safe —
# the SDK is a no-op until a DSN is set. Set SENTRY_LARAVEL_DSN in production.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.2

# Production/staging target is MySQL 8 (docs/02-DATABASE-SCHEMA.md, database/schema/mysql-schema.sql).
# SQLite here is a LOCAL DEV convenience only — there is no MySQL server on this
# machine to develop against. Sprint 1's tables (users, settings, webhook_events,
# permission tables) are DB-agnostic; switch to mysql below the moment a server
# is available, well before any migration uses a MySQL-specific feature
# (generated columns, CHECK constraints — see receipts/campaign_products).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vgwgf
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@visiongoodworkglobalfoundation.org"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS="admin@visiongoodworkglobalfoundation.org"

# Filled in when the Razorpay account is provisioned — day-1 action per
# docs/03-ROADMAP.md Sprint 1 (recurring-payments approval takes 2-3 weeks).
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AdminUserSeeder refuses to seed a super-admin without both of these set —
# see database/seeders/AdminUserSeeder.php. Change the password on first login.
ADMIN_SEED_EMAIL=admin@visiongoodworkglobalfoundation.org
ADMIN_SEED_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Off-site nightly backup destination (config/filesystems.php's
# `backup-offsite` disk) — deliberately separate from the AWS_* creds above
# so the backup bucket is never the same one app code writes public assets
# to. See docs/09-BACKUP-RESTORE.md. Left blank in dev/staging is safe:
# config/backup.php sets continue_on_failure so a missing off-site disk
# never blocks the local backup from completing.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=us-east-1
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

VITE_APP_NAME="${APP_NAME}"
